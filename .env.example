# Supabase → Project Settings → API (of "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project-id.supabase.co
# De anon key of de nieuwe "publishable key" (sb_publishable_...) — beide werken
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-of-publishable-key
# Domein dat achter je inlognaam wordt geplakt: naam "timo" wordt timo@iso3166.nl
NEXT_PUBLIC_LOGIN_DOMEIN=iso3166.nl
